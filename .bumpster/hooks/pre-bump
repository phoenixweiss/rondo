#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
: "${BUMPSTER_PREV_VERSION:?Bumpster previous version is required}"
: "${BUMPSTER_NEW_VERSION:?Bumpster new version is required}"
.venv/bin/python tools/build_core.py
.venv/bin/python tools/check.py
.venv/bin/python tools/release.py prepare-changelog
git diff --check
git add CHANGELOG.md
